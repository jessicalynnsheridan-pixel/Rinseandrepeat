# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe Price IDs (from your Stripe dashboard)
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_CEO_MONTHLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_CEO_YEARLY_PRICE_ID=price_...

# OpenAI (for AI assistant)
OPENAI_API_KEY=sk-...

# App URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Stan Store (optional — for webhook-based plan upgrades)
STAN_WEBHOOK_SECRET=your-stan-webhook-secret
STAN_PRO_MONTHLY_PRODUCT_ID=
STAN_PRO_YEARLY_PRODUCT_ID=
STAN_CEO_MONTHLY_PRODUCT_ID=
STAN_CEO_YEARLY_PRODUCT_ID=
STAN_WEBHOOK_DEBUG=false
